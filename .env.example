NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_NAME=pariflow-back
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PREFIX=api/v1
LOG_LEVEL=log

# Use DATABASE_URL ou DB_*.
DATABASE_URL=mysql://pariflow_app:PariFlowLocal%212026@127.0.0.1:3308/pariflow_partners
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=pariflow_app
DB_PASSWORD=PariFlowLocal!2026
DB_NAME=pariflow_partners

JWT_ACCESS_SECRET=change-this-access-secret-with-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_SECRET=change-this-refresh-secret-with-at-least-32-chars
JWT_REFRESH_TTL_DAYS=15

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
DEV_AUTH_BYPASS=false
PREVIEW_AUTH_BYPASS=false
SWAGGER_ENABLED=true
TRUST_PROXY=false

# Firebase Admin fica somente no backend. Nao copiar para o front.
FIREBASE_PROJECT_ID=pfp-yar-2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

AWS_REGION=us-east-2
S3_BUCKET_PRIVATE=
SENSITIVE_SESSION_TTL_MINUTES=10
PUBLIC_SUBMISSIONS_ENABLED=false
PUBLIC_SUBMISSION_TOKEN=

# Notification outbox / SMTP.
NOTIFICATION_OUTBOX_WORKER_ENABLED=true
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=30000
NOTIFICATION_OUTBOX_BATCH_SIZE=10
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PariFlow Partners <seu-email@gmail.com>"
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v25.0

# WhatsApp Sender API: usado pelo worker para notificacoes comerciais e lembretes.
# Deve ser o token do phone number selecionado no painel "Send and receive messages".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Manager API: usado apenas para gestao, suporte e validacao manual.
# Nao deve substituir WHATSAPP_ACCESS_TOKEN, pois o worker de envio nao usa este token.
WHATSAPP_MANAGER_ACCESS_TOKEN=

# Token usado apenas no handshake do webhook configurado no painel da Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Opcional. Sem template, tenta enviar texto livre dentro da janela permitida pela Meta.
# Para notificacoes proativas, configure um template aprovado com uma variavel no corpo.
WHATSAPP_DEFAULT_TEMPLATE_NAME=
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=pt_BR
META_APP_ID=
META_CLIENT_TOKEN=
META_APP_SECRET=
WHATSAPP_SUPPORT_PHONE=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

SEED_ADMIN_NAME=Administrador Local
SEED_ADMIN_EMAIL=dev@local.test
SEED_ADMIN_FIREBASE_UID=
SEED_ENABLE_SAMPLE_DATA=false
