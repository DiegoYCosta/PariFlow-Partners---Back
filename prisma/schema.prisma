generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserSystemStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AccessProfileCode {
  ADMIN
  EXECUTIVE
  LEGAL
  HR
  OPERATIONS
}

enum EmploymentLinkStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISMISSED
  BLOCKED
}

enum OccurrenceNature {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum OccurrenceVisibility {
  INTERNAL
  SENSITIVE
  CRITICAL
}

enum AttachmentStatus {
  ACTIVE
  DELETED
}

enum ContractCatalogStatus {
  ACTIVE
  INACTIVE
}

enum ContractDocumentStatus {
  ACTIVE
  DELETED
}

enum AttachmentClassification {
  FORMAL_DOCUMENT
  SENSITIVE_ATTACHMENT
  SUPPORTING_REFERENCE
}

enum SensitiveAudienceGroup {
  DIRECTOR
  SUPERVISION
  AUXILIARY
}

enum EntityTagTargetType {
  PERSON
  PROVIDER_COMPANY
}

enum EntityTagClassification {
  BEHAVIORAL_SIGNAL
  ROUTINE_CONTEXT
  FAMILY_CONTEXT
  TRAINING_OR_SKILL
  PERSONAL_CONTEXT
  OPERATIONAL_RISK
}

enum EntityTagStatus {
  ACTIVE
  REMOVED
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum SensitiveSessionLevel {
  SENSITIVE
  CRITICAL
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  SESSION_EXCHANGED
  REFRESH_ROTATED
  SENSITIVE_SESSION_STARTED
  SENSITIVE_SESSION_VERIFIED
  ACCESS_DENIED
}

enum CalendarEntryKind {
  REMINDER
  APPOINTMENT
}

enum CalendarEntryStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  MISSED
}

enum CalendarEntryPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CalendarBusinessDayPolicy {
  ALLOW_NON_BUSINESS_DAY
  REQUIRE_BUSINESS_DAY
  MOVE_TO_PREVIOUS_BUSINESS_DAY
  MOVE_TO_NEXT_BUSINESS_DAY
}

enum CalendarNotificationPolicy {
  ON_DUE_DATE
  ONE_BUSINESS_DAY_BEFORE
  SAME_DAY_OR_PREVIOUS_BUSINESS_DAY
  CUSTOM_BUSINESS_DAYS_BEFORE
}

enum CalendarEntryTargetType {
  GENERAL
  PERSON
  PROVIDER_COMPANY
  CLIENT_COMPANY
  CONTRACT
  EMPLOYMENT_LINK
  POSITION
}

enum ClientOnboardingCnpjStatus {
  AVAILABLE
  AVAILABLE_FOR_TEST
  IN_USE
  UNAVAILABLE
}

enum ClientOnboardingContractType {
  ACTIVE_CLIENT
  DEMO_ACCESS
  UNAVAILABLE
}

enum ClientOnboardingRequestStatus {
  PENDING_REVIEW
  PENDING_VERIFICATION
  RELEASED
  REJECTED
  UNAVAILABLE
}

enum ClientOnboardingVerificationChannel {
  EMAIL
  PHONE
  NONE
}

enum TenantRootCompanyStatus {
  PENDING_REVIEW
  PENDING_VERIFICATION
  ACTIVE
  DEMO
  UNAVAILABLE
}

model TenantRootCompany {
  id                    BigInt                       @id @default(autoincrement())
  publicId              String                       @unique @db.VarChar(26)
  tradeName             String                       @db.VarChar(180)
  legalName             String                       @db.VarChar(180)
  cnpj                  String                       @unique @db.VarChar(14)
  stateRegistration     String?                      @db.VarChar(40)
  municipalRegistration String?                      @db.VarChar(40)
  companyType           String                       @db.VarChar(80)
  segment               String                       @db.VarChar(180)
  primaryCnae           String?                      @db.VarChar(16)
  companySize           String                       @db.VarChar(50)
  contractType          ClientOnboardingContractType
  status                TenantRootCompanyStatus      @default(PENDING_VERIFICATION)
  isRootCompany         Boolean                      @default(true)
  deletionLocked        Boolean                      @default(true)
  primaryContactName    String                       @db.VarChar(160)
  primaryContactEmail   String?                      @db.VarChar(180)
  primaryContactPhone   String?                      @db.VarChar(30)
  accountQuotasJson     Json?
  verifiedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  onboardingRequests    ClientOnboardingRequest[]    @relation("TenantRootCompanyOnboardingRequests")
  userSystems           UserSystem[]                 @relation("UserSystemTenantRootCompany")
  providerCompanies     ProviderCompany[]            @relation("ProviderCompanyTenantRootCompany")
  clientCompanies       ClientCompany[]              @relation("ClientCompanyTenantRootCompany")
  contracts             Contract[]                   @relation("ContractTenantRootCompany")
  people                Person[]                     @relation("PersonTenantRootCompany")
  positions             Position[]                   @relation("PositionTenantRootCompany")
  employmentLinks       EmploymentLink[]             @relation("EmploymentLinkTenantRootCompany")
  occurrences           Occurrence[]                 @relation("OccurrenceTenantRootCompany")
  attachments           Attachment[]                 @relation("AttachmentTenantRootCompany")
  entityTags            EntityTag[]                  @relation("EntityTagTenantRootCompany")
  calendarEntries       CalendarEntry[]              @relation("CalendarEntryTenantRootCompany")
  securityEvents        SecurityEvent[]              @relation("SecurityEventTenantRootCompany")
  auditLogs             AuditLog[]                   @relation("AuditLogTenantRootCompany")

  @@index([status, createdAt])
  @@map("empresa_raiz_cliente")
}

model ClientOnboardingRequest {
  id                          BigInt                              @id @default(autoincrement())
  publicId                    String                              @unique @db.VarChar(26)
  tenantRootCompanyId         BigInt?
  cnpj                        String                              @db.VarChar(14)
  tradeName                   String                              @db.VarChar(180)
  legalName                   String                              @db.VarChar(180)
  stateRegistration           String?                             @db.VarChar(40)
  municipalRegistration       String?                             @db.VarChar(40)
  companyType                 String                              @db.VarChar(80)
  segment                     String                              @db.VarChar(180)
  primaryCnae                 String?                             @db.VarChar(16)
  companySize                 String                              @db.VarChar(50)
  cnpjStatus                  ClientOnboardingCnpjStatus
  contractType                ClientOnboardingContractType
  status                      ClientOnboardingRequestStatus       @default(PENDING_VERIFICATION)
  primaryContactName          String                              @db.VarChar(160)
  primaryContactEmail         String?                             @db.VarChar(180)
  primaryContactPhone         String?                             @db.VarChar(30)
  accountQuotasJson           Json?
  verificationAccepted        Boolean                             @default(false)
  verificationChannel         ClientOnboardingVerificationChannel @default(NONE)
  verificationTarget          String?                             @db.VarChar(180)
  verificationMatchedRegistry Boolean                             @default(false)
  reviewNotificationEmail     String?                             @db.VarChar(180)
  submittedAt                 DateTime                            @default(now())
  releasedAt                  DateTime?
  reviewedAt                  DateTime?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  tenantRootCompany           TenantRootCompany?                  @relation("TenantRootCompanyOnboardingRequests", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([cnpj, submittedAt])
  @@index([status, submittedAt])
  @@index([tenantRootCompanyId])
  @@map("cliente_onboarding_solicitacao")
}

model UserSystem {
  id                      BigInt                   @id @default(autoincrement())
  publicId                String                   @unique @db.VarChar(26)
  firebaseUid             String?                  @unique @db.VarChar(128)
  tenantRootCompanyId     BigInt?
  providerCompanyId       BigInt?
  clientCompanyId         BigInt?
  name                    String                   @db.VarChar(160)
  email                   String                   @unique @db.VarChar(180)
  status                  UserSystemStatus         @default(ACTIVE)
  mfaEnabled              Boolean                  @default(false)
  lastAccessAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accessProfiles          UserAccessProfile[]
  refreshTokens           RefreshToken[]
  securityEvents          SecurityEvent[]
  sensitiveAccess         SensitiveSession[]
  auditLogs               AuditLog[]
  createdEntityTags       EntityTag[]              @relation("EntityTagCreatedBy")
  removedEntityTags       EntityTag[]              @relation("EntityTagRemovedBy")
  ownedEntityTags         EntityTag[]              @relation("EntityTagOwnedBy")
  ownedAttachments        Attachment[]             @relation("AttachmentOwnedBy")
  createdAttachments      Attachment[]             @relation("AttachmentCreatedBy")
  entityTagAudience       EntityTagAudienceUser[]
  attachmentAudience      AttachmentAudienceUser[]
  tenantRootCompany       TenantRootCompany?       @relation("UserSystemTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)
  providerCompany         ProviderCompany?         @relation("UserSystemProviderCompany", fields: [providerCompanyId], references: [id], onDelete: SetNull)
  clientCompany           ClientCompany?           @relation("UserSystemClientCompany", fields: [clientCompanyId], references: [id], onDelete: SetNull)
  createdCalendarEntries  CalendarEntry[]          @relation("CalendarEntryCreatedBy")
  assignedCalendarEntries CalendarEntry[]          @relation("CalendarEntryAssignedTo")

  @@index([tenantRootCompanyId])
  @@index([providerCompanyId])
  @@index([clientCompanyId])
  @@map("usuario_sistema")
}

model AccessProfile {
  id               BigInt              @id @default(autoincrement())
  publicId         String              @unique @db.VarChar(26)
  code             AccessProfileCode   @unique
  name             String              @db.VarChar(120)
  description      String?             @db.VarChar(255)
  canViewSensitive Boolean             @default(false)
  canDownload      Boolean             @default(false)
  canSoftDelete    Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  users            UserAccessProfile[]

  @@map("perfil_acesso")
}

model UserAccessProfile {
  id              BigInt        @id @default(autoincrement())
  userSystemId    BigInt
  accessProfileId BigInt
  createdAt       DateTime      @default(now())
  userSystem      UserSystem    @relation(fields: [userSystemId], references: [id], onDelete: Cascade)
  accessProfile   AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)

  @@unique([userSystemId, accessProfileId])
  @@map("usuario_perfil_acesso")
}

model ProviderCompany {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  legalName           String             @db.VarChar(180)
  tradeName           String?            @db.VarChar(180)
  document            String             @unique @db.VarChar(20)
  status              String             @db.VarChar(30)
  contactsJson        Json?
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  contracts           Contract[]
  links               EmploymentLink[]
  occurrences         Occurrence[]
  entityTags          EntityTag[]
  userSystems         UserSystem[]       @relation("UserSystemProviderCompany")
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany? @relation("ProviderCompanyTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("empresa_prestadora")
}

model ClientCompany {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  name                String             @db.VarChar(180)
  document            String?            @db.VarChar(20)
  clientType          String             @db.VarChar(60)
  addressJson         Json?
  contactName         String?            @db.VarChar(160)
  status              String             @db.VarChar(30)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  contracts           Contract[]
  userSystems         UserSystem[]       @relation("UserSystemClientCompany")
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany? @relation("ClientCompanyTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("cliente_contratante")
}

model Contract {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  providerCompanyId   BigInt
  clientCompanyId     BigInt
  contractTypeId      BigInt?
  contractModelId     BigInt?
  startsAt            DateTime
  endsAt              DateTime?
  status              String             @db.VarChar(30)
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  providerCompany     ProviderCompany    @relation(fields: [providerCompanyId], references: [id], onDelete: Restrict)
  clientCompany       ClientCompany      @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  contractType        ContractType?      @relation(fields: [contractTypeId], references: [id], onDelete: SetNull)
  contractModel       ContractModel?     @relation(fields: [contractModelId], references: [id], onDelete: SetNull)
  documents           ContractDocument[]
  positions           Position[]
  links               EmploymentLink[]
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany? @relation("ContractTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("contrato")
}

model ContractType {
  id             BigInt                @id @default(autoincrement())
  publicId       String                @unique @db.VarChar(26)
  name           String                @unique @db.VarChar(120)
  description    String?               @db.Text
  status         ContractCatalogStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  contractModels ContractModel[]
  contracts      Contract[]

  @@map("tipo_contrato")
}

model ContractModel {
  id              BigInt                @id @default(autoincrement())
  publicId        String                @unique @db.VarChar(26)
  contractTypeId  BigInt
  name            String                @db.VarChar(140)
  description     String?               @db.Text
  defaultSchedule String?               @db.VarChar(120)
  status          ContractCatalogStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  contractType    ContractType          @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  contracts       Contract[]

  @@unique([contractTypeId, name])
  @@map("modelo_contrato")
}

model ContractDocument {
  id               BigInt                   @id @default(autoincrement())
  publicId         String                   @unique @db.VarChar(26)
  contractId       BigInt
  title            String                   @db.VarChar(180)
  classification   AttachmentClassification @default(FORMAL_DOCUMENT)
  fileName         String?                  @db.VarChar(180)
  mimeType         String?                  @db.VarChar(120)
  externalLink     String?                  @db.VarChar(255)
  physicalLocation String?                  @db.VarChar(255)
  notes            String?                  @db.Text
  status           ContractDocumentStatus   @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  contract         Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
  @@map("documento_contrato")
}

model ServiceCatalog {
  id          BigInt     @id @default(autoincrement())
  publicId    String     @unique @db.VarChar(26)
  name        String     @db.VarChar(120)
  category    String?    @db.VarChar(80)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  positions   Position[]

  @@map("servico")
}

model Position {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  contractId          BigInt
  serviceId           BigInt
  name                String             @db.VarChar(160)
  location            String?            @db.VarChar(180)
  shift               String?            @db.VarChar(120)
  schedule            String?            @db.VarChar(120)
  requirements        String?            @db.Text
  status              String             @db.VarChar(30)
  contract            Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  service             ServiceCatalog     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  links               EmploymentLink[]
  occurrences         Occurrence[]
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany? @relation("PositionTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("posto_ou_vaga")
}

model Person {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  name                String             @db.VarChar(160)
  cpf                 String?            @unique @db.VarChar(14)
  rg                  String?            @db.VarChar(30)
  email               String?            @db.VarChar(180)
  phone               String?            @db.VarChar(30)
  birthDate           DateTime?
  addressJson         Json?
  notes               String?            @db.Text
  externalWorks       ExternalWork[]
  links               EmploymentLink[]
  occurrences         Occurrence[]
  entityTags          EntityTag[]
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany? @relation("PersonTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("pessoa")
}

model ExternalWork {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @db.VarChar(26)
  personId    BigInt
  companyName String    @db.VarChar(180)
  roleName    String?   @db.VarChar(120)
  schedule    String?   @db.VarChar(120)
  startsAt    DateTime?
  endsAt      DateTime?
  status      String?   @db.VarChar(30)
  notes       String?   @db.Text
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("trabalho_externo")
}

model EmploymentLink {
  id                  BigInt               @id @default(autoincrement())
  publicId            String               @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  personId            BigInt
  providerCompanyId   BigInt
  contractId          BigInt
  positionId          BigInt
  type                String               @db.VarChar(60)
  status              EmploymentLinkStatus @default(PENDING)
  startsAt            DateTime
  endsAt              DateTime?
  person              Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  providerCompany     ProviderCompany      @relation(fields: [providerCompanyId], references: [id], onDelete: Restrict)
  contract            Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  position            Position             @relation(fields: [positionId], references: [id], onDelete: Restrict)
  moves               EmploymentMove[]
  dismissal           Dismissal?
  occurrences         Occurrence[]
  calendarEntries     CalendarEntry[]
  tenantRootCompany   TenantRootCompany?   @relation("EmploymentLinkTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("vinculo")
}

model EmploymentMove {
  id               BigInt         @id @default(autoincrement())
  publicId         String         @unique @db.VarChar(26)
  employmentLinkId BigInt
  moveType         String         @db.VarChar(60)
  origin           String?        @db.VarChar(160)
  destination      String?        @db.VarChar(160)
  movedAt          DateTime
  notes            String?        @db.Text
  employmentLink   EmploymentLink @relation(fields: [employmentLinkId], references: [id], onDelete: Cascade)

  @@map("movimentacao_vinculo")
}

model Dismissal {
  id               BigInt         @id @default(autoincrement())
  publicId         String         @unique @db.VarChar(26)
  employmentLinkId BigInt         @unique
  dismissedAt      DateTime
  reason           String         @db.VarChar(180)
  dismissalType    String?        @db.VarChar(60)
  riskSummary      String?        @db.Text
  pendingIssues    String?        @db.Text
  legalNotes       String?        @db.Text
  employmentLink   EmploymentLink @relation(fields: [employmentLinkId], references: [id], onDelete: Cascade)

  @@map("desligamento")
}

model Occurrence {
  id                   BigInt               @id @default(autoincrement())
  publicId             String               @unique @db.VarChar(26)
  tenantRootCompanyId  BigInt?
  personId             BigInt
  providerCompanyId    BigInt?
  employmentLinkId     BigInt?
  positionId           BigInt?
  type                 String               @db.VarChar(80)
  scope                String               @db.VarChar(60)
  nature               OccurrenceNature
  title                String               @db.VarChar(160)
  description          String               @db.Text
  occurredAt           DateTime
  severityLevel        String               @db.VarChar(40)
  visibility           OccurrenceVisibility @default(INTERNAL)
  showInExecutivePanel Boolean              @default(false)
  status               String               @db.VarChar(30)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  person               Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  providerCompany      ProviderCompany?     @relation(fields: [providerCompanyId], references: [id], onDelete: SetNull)
  employmentLink       EmploymentLink?      @relation(fields: [employmentLinkId], references: [id], onDelete: SetNull)
  position             Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  attachments          Attachment[]
  receipts             DocumentReceipt[]
  tenantRootCompany    TenantRootCompany?   @relation("OccurrenceTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("ocorrencia")
}

model Attachment {
  id                    BigInt                    @id @default(autoincrement())
  publicId              String                    @unique @db.VarChar(26)
  tenantRootCompanyId   BigInt?
  occurrenceId          BigInt
  ownerUserSystemId     BigInt?
  createdByUserSystemId BigInt?
  displayScope          String                    @db.VarChar(60)
  classification        AttachmentClassification  @default(FORMAL_DOCUMENT)
  fileName              String                    @db.VarChar(180)
  mimeType              String?                   @db.VarChar(120)
  storagePath           String?                   @db.VarChar(255)
  externalLink          String?                   @db.VarChar(255)
  physicalLocation      String?                   @db.VarChar(255)
  visibleInExecutive    Boolean                   @default(false)
  visibleInContext      Boolean                   @default(true)
  requiresConfirmation  Boolean                   @default(false)
  version               Int                       @default(1)
  status                AttachmentStatus          @default(ACTIVE)
  deletedAt             DateTime?
  deleteReason          String?                   @db.VarChar(255)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  occurrence            Occurrence                @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  ownerUserSystem       UserSystem?               @relation("AttachmentOwnedBy", fields: [ownerUserSystemId], references: [id], onDelete: SetNull)
  createdByUserSystem   UserSystem?               @relation("AttachmentCreatedBy", fields: [createdByUserSystemId], references: [id], onDelete: SetNull)
  audienceGroups        AttachmentAudienceGroup[]
  audienceUsers         AttachmentAudienceUser[]
  tenantRootCompany     TenantRootCompany?        @relation("AttachmentTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@map("anexo")
}

model EntityTag {
  id                    BigInt                   @id @default(autoincrement())
  publicId              String                   @unique @db.VarChar(26)
  tenantRootCompanyId   BigInt?
  targetType            EntityTagTargetType
  personId              BigInt?
  providerCompanyId     BigInt?
  classification        EntityTagClassification
  status                EntityTagStatus          @default(ACTIVE)
  label                 String                   @db.VarChar(80)
  content               String                   @db.VarChar(350)
  color                 String                   @db.VarChar(32)
  sortOrder             Int                      @default(0)
  isAnonymousSubmission Boolean                  @default(true)
  ownerUserSystemId     BigInt?
  createdByUserSystemId BigInt?
  removedByUserSystemId BigInt?
  removedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  person                Person?                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  providerCompany       ProviderCompany?         @relation(fields: [providerCompanyId], references: [id], onDelete: Cascade)
  ownerUserSystem       UserSystem?              @relation("EntityTagOwnedBy", fields: [ownerUserSystemId], references: [id], onDelete: SetNull)
  createdByUserSystem   UserSystem?              @relation("EntityTagCreatedBy", fields: [createdByUserSystemId], references: [id], onDelete: SetNull)
  removedByUserSystem   UserSystem?              @relation("EntityTagRemovedBy", fields: [removedByUserSystemId], references: [id], onDelete: SetNull)
  audienceGroups        EntityTagAudienceGroup[]
  audienceUsers         EntityTagAudienceUser[]
  tenantRootCompany     TenantRootCompany?       @relation("EntityTagTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId])
  @@index([targetType, status, sortOrder])
  @@index([personId, status])
  @@index([providerCompanyId, status])
  @@map("tag_entidade")
}

model AttachmentAudienceGroup {
  id           BigInt                 @id @default(autoincrement())
  attachmentId BigInt
  groupKey     SensitiveAudienceGroup
  createdAt    DateTime               @default(now())
  attachment   Attachment             @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, groupKey])
  @@map("anexo_grupo_visibilidade")
}

model AttachmentAudienceUser {
  id           BigInt     @id @default(autoincrement())
  attachmentId BigInt
  userSystemId BigInt
  createdAt    DateTime   @default(now())
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  userSystem   UserSystem @relation(fields: [userSystemId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, userSystemId])
  @@map("anexo_usuario_visibilidade")
}

model EntityTagAudienceGroup {
  id          BigInt                 @id @default(autoincrement())
  entityTagId BigInt
  groupKey    SensitiveAudienceGroup
  createdAt   DateTime               @default(now())
  entityTag   EntityTag              @relation(fields: [entityTagId], references: [id], onDelete: Cascade)

  @@unique([entityTagId, groupKey])
  @@map("tag_entidade_grupo_visibilidade")
}

model EntityTagAudienceUser {
  id           BigInt     @id @default(autoincrement())
  entityTagId  BigInt
  userSystemId BigInt
  createdAt    DateTime   @default(now())
  entityTag    EntityTag  @relation(fields: [entityTagId], references: [id], onDelete: Cascade)
  userSystem   UserSystem @relation(fields: [userSystemId], references: [id], onDelete: Cascade)

  @@unique([entityTagId, userSystemId])
  @@map("tag_entidade_usuario_visibilidade")
}

model DocumentReceipt {
  id           BigInt     @id @default(autoincrement())
  publicId     String     @unique @db.VarChar(26)
  occurrenceId BigInt
  receivedAt   DateTime
  channel      String?    @db.VarChar(80)
  receivedBy   String?    @db.VarChar(160)
  notes        String?    @db.Text
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("recebimento_documento")
}

model CalendarEntry {
  id                             BigInt                     @id @default(autoincrement())
  publicId                       String                     @unique @db.VarChar(26)
  tenantRootCompanyId            BigInt?
  kind                           CalendarEntryKind
  status                         CalendarEntryStatus        @default(SCHEDULED)
  priority                       CalendarEntryPriority      @default(NORMAL)
  targetType                     CalendarEntryTargetType    @default(GENERAL)
  title                          String                     @db.VarChar(180)
  description                    String?                    @db.Text
  startsAt                       DateTime
  endsAt                         DateTime?
  timezone                       String                     @default("America/Sao_Paulo") @db.VarChar(64)
  isAllDay                       Boolean                    @default(false)
  businessDayPolicy              CalendarBusinessDayPolicy  @default(ALLOW_NON_BUSINESS_DAY)
  holidayRegionCode              String?                    @db.VarChar(40)
  notificationPolicy             CalendarNotificationPolicy @default(ONE_BUSINESS_DAY_BEFORE)
  notificationOffsetBusinessDays Int                        @default(1)
  notificationTime               String                     @default("09:00") @db.VarChar(5)
  notificationScheduledAt        DateTime?
  notificationChannelsJson       Json?
  personId                       BigInt?
  providerCompanyId              BigInt?
  clientCompanyId                BigInt?
  contractId                     BigInt?
  employmentLinkId               BigInt?
  positionId                     BigInt?
  createdByUserSystemId          BigInt?
  assignedToUserSystemId         BigInt?
  completedAt                    DateTime?
  canceledAt                     DateTime?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  person                         Person?                    @relation(fields: [personId], references: [id], onDelete: SetNull)
  providerCompany                ProviderCompany?           @relation(fields: [providerCompanyId], references: [id], onDelete: SetNull)
  clientCompany                  ClientCompany?             @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  contract                       Contract?                  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  employmentLink                 EmploymentLink?            @relation(fields: [employmentLinkId], references: [id], onDelete: SetNull)
  position                       Position?                  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdByUserSystem            UserSystem?                @relation("CalendarEntryCreatedBy", fields: [createdByUserSystemId], references: [id], onDelete: SetNull)
  assignedToUserSystem           UserSystem?                @relation("CalendarEntryAssignedTo", fields: [assignedToUserSystemId], references: [id], onDelete: SetNull)
  tenantRootCompany              TenantRootCompany?         @relation("CalendarEntryTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId, startsAt])
  @@index([startsAt, status])
  @@index([kind, startsAt])
  @@index([personId, startsAt])
  @@index([providerCompanyId, startsAt])
  @@index([clientCompanyId, startsAt])
  @@index([contractId, startsAt])
  @@index([employmentLinkId, startsAt])
  @@index([positionId, startsAt])
  @@index([createdByUserSystemId, startsAt])
  @@index([assignedToUserSystemId, startsAt])
  @@index([notificationScheduledAt])
  @@map("agenda_item")
}

model RefreshToken {
  id           BigInt             @id @default(autoincrement())
  publicId     String             @unique @db.VarChar(26)
  userSystemId BigInt
  tokenHash    String             @db.VarChar(255)
  status       RefreshTokenStatus @default(ACTIVE)
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  ipAddress    String?            @db.VarChar(64)
  userAgent    String?            @db.VarChar(255)
  createdAt    DateTime           @default(now())
  userSystem   UserSystem         @relation(fields: [userSystemId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SensitiveSession {
  id            BigInt                @id @default(autoincrement())
  publicId      String                @unique @db.VarChar(26)
  userSystemId  BigInt
  level         SensitiveSessionLevel
  justification String?               @db.Text
  verifiedAt    DateTime
  expiresAt     DateTime
  ipAddress     String?               @db.VarChar(64)
  userAgent     String?               @db.VarChar(255)
  userSystem    UserSystem            @relation(fields: [userSystemId], references: [id], onDelete: Cascade)

  @@map("sensitive_sessions")
}

model SecurityEvent {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  userSystemId        BigInt?
  eventType           SecurityEventType
  description         String             @db.VarChar(255)
  ipAddress           String?            @db.VarChar(64)
  userAgent           String?            @db.VarChar(255)
  createdAt           DateTime           @default(now())
  userSystem          UserSystem?        @relation(fields: [userSystemId], references: [id], onDelete: SetNull)
  tenantRootCompany   TenantRootCompany? @relation("SecurityEventTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId, createdAt])
  @@map("security_events")
}

model AuditLog {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @db.VarChar(26)
  tenantRootCompanyId BigInt?
  userSystemId        BigInt?
  entityName          String             @db.VarChar(80)
  entityPublicId      String?            @db.VarChar(26)
  action              String             @db.VarChar(60)
  description         String?            @db.Text
  ipAddress           String?            @db.VarChar(64)
  device              String?            @db.VarChar(255)
  createdAt           DateTime           @default(now())
  userSystem          UserSystem?        @relation(fields: [userSystemId], references: [id], onDelete: SetNull)
  tenantRootCompany   TenantRootCompany? @relation("AuditLogTenantRootCompany", fields: [tenantRootCompanyId], references: [id], onDelete: SetNull)

  @@index([tenantRootCompanyId, createdAt])
  @@map("log_auditoria")
}
